{
  "name": "gitpulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-platform, local-first Git repository monitor with system tray, live status, and read-only dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pallab-js/git_client_rust.git"
  },
  "bugs": {
    "url": "https://github.com/pallab-js/git_client_rust/issues"
  },
  "homepage": "https://github.com/pallab-js/git_client_rust#readme",
  "keywords": [
    "git",
    "repository-monitor",
    "system-tray",
    "tauri",
    "rust",
    "react",
    "local-first",
    "cross-platform",
    "developer-tools",
    "version-control"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}